# Copy to .env and fill in real values before running `docker compose up`.
# NEVER commit the real .env file — it's already in .gitignore.

# --- Database ---
DB_NAME=nwm
DB_USERNAME=nwm
DB_PASSWORD=change-me
# Host-side port only (the app always reaches postgres over the internal
# Docker network) — defaults to 5433, not 5432, since 5432 very commonly
# collides with a locally-installed Postgres or another project's container.
DB_HOST_PORT=5433

# --- Other host-side port overrides (only needed if the defaults collide
# with something else already running on your machine) ---
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_MANAGEMENT_HOST_PORT=15672
# S3_HOST_PORT=9000
# S3_CONSOLE_HOST_PORT=9001
# APP_HOST_PORT=8080

# --- RabbitMQ ---
RABBITMQ_USERNAME=nwm
RABBITMQ_PASSWORD=change-me

# --- S3 / MinIO ---
S3_REGION=us-east-1
S3_BUCKET=nwm-audio
S3_ACCESS_KEY=nwm
S3_SECRET_KEY=change-me-min-8-chars

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID
# Authorized redirect URI: {your-api-url}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App URLs ---
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Account lockout (defaults are usually fine) ---
LOCKOUT_FAILURE_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# --- Per-user rate limiting on /api/tts and /api/billing (defaults are usually fine) ---
RATE_LIMIT_USER_CAPACITY=30
RATE_LIMIT_USER_REFILL=30

# --- Debugging /actuator/health ---
# Uncomment temporarily to see WHICH dependency (db/s3/rabbit/diskSpace) is
# actually reporting DOWN — normally hidden since these endpoints have no
# login to be "authorized" against.
# MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# --- Transactional email (password reset / email verification) ---
# Off by default — password reset and verification links are just logged
# instead of emailed, so the flow is testable without SMTP credentials. Flip
# to true and fill in SMTP_* once you have a real mail provider.
MAIL_ENABLED=false
MAIL_FROM=noreply@nwm.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- Stripe ---
# Billing is on by default and the app refuses to boot without a secret key
# (same fail-fast philosophy as Google OAuth below) — set this to false to
# run everything else (auth, TTS orchestration) without setting up Stripe
# yet, then flip it once the keys below are filled in.
STRIPE_ENABLED=false
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > Add endpoint ({your-api-url}/api/billing/webhook)
# Select events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout redirects after a successful/canceled payment, and
# where the Billing Portal sends the user back to.
STRIPE_SUCCESS_URL=http://localhost:4200/app/checkout/success
STRIPE_CANCEL_URL=http://localhost:4200/pricing
STRIPE_PORTAL_RETURN_URL=http://localhost:4200/app/profile

# Dashboard > Product catalog — create one recurring Price per paid plan per
# billing cycle, and one one-time Price per top-up pack, then paste their
# ids (price_...) here. Leave a plan/cycle combination blank if you don't
# want to sell it yet — checkout for it will fail with a clear error
# instead of silently using the wrong price.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=
