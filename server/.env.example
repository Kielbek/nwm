# Copy to .env and fill in real values before running `docker compose up`.
# NEVER commit the real .env file — it's already in .gitignore.

# --- Database ---
DB_NAME=nwm
DB_USERNAME=nwm
DB_PASSWORD=change-me

# --- RabbitMQ ---
RABBITMQ_USERNAME=nwm
RABBITMQ_PASSWORD=change-me

# --- S3 / MinIO ---
S3_REGION=us-east-1
S3_BUCKET=nwm-audio
S3_ACCESS_KEY=nwm
S3_SECRET_KEY=change-me-min-8-chars

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID
# Authorized redirect URI: {your-api-url}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App URLs ---
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
