# Copy to .env and adjust. Defaults match server/docker-compose.yml so the
# two services can share one broker/bucket in local dev.

# --- RabbitMQ (must match the Spring server's RABBITMQ_* values) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=nwm
RABBITMQ_PASSWORD=change-me

# --- S3 / MinIO (must match the Spring server's S3_* values) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nwm-audio
S3_ACCESS_KEY=nwm
S3_SECRET_KEY=change-me-min-8-chars
S3_PATH_STYLE_ACCESS=true

# --- XTTS ---
# "cuda" if you have an NVIDIA GPU available — CPU inference works but is
# slow (expect tens of seconds per short chunk).
XTTS_DEVICE=cpu
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
# Required by Coqui's model downloader to confirm you've read the model's
# license (Coqui Public Model License — non-commercial, see README.md).
COQUI_TOS_AGREED=1
# Max characters per XTTS call — longer chunks degrade prosody.
XTTS_MAX_CHUNK_CHARS=250
# Language to fall back to when auto-detection fails or lands on something
# XTTS doesn't support.
DEFAULT_LANGUAGE=pl
# How many jobs this worker process pulls at once. Keep at 1 unless you've
# verified your GPU/CPU can actually run synthesis concurrently — XTTS
# inference is memory-heavy per call.
WORKER_PREFETCH_COUNT=1

# Absolute path to the folder of reference voice samples (voiceId.wav).
# Defaults to ./voices next to this file if unset.
# VOICES_DIR=/path/to/worker/voices
